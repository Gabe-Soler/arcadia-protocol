{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabe-Soler/arcadia-protocol/v0.2.0/schemas/event.schema.json",
  "title": "Simulation event",
  "description": "Simulator -> coordinator: what the site observed since the last observation. Every event carries the sim time `t` at which it happened.",
  "$ref": "#/$defs/Event",
  "$defs": {
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/CommandAccepted"
        },
        {
          "$ref": "#/$defs/CommandRejected"
        },
        {
          "$ref": "#/$defs/CommandCompleted"
        },
        {
          "$ref": "#/$defs/CommandFailed"
        },
        {
          "$ref": "#/$defs/ScanResult"
        },
        {
          "$ref": "#/$defs/RobotFault"
        },
        {
          "$ref": "#/$defs/Weather"
        },
        {
          "$ref": "#/$defs/Power"
        },
        {
          "$ref": "#/$defs/Comms"
        },
        {
          "$ref": "#/$defs/EarthMessage"
        }
      ]
    },
    "CommandAccepted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_accepted"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "estimated_duration_s": {
          "$ref": "common.schema.json#/$defs/Duration"
        }
      },
      "required": [
        "type",
        "t",
        "command_id",
        "robot_id",
        "estimated_duration_s"
      ],
      "additionalProperties": false
    },
    "CommandRejected": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_rejected"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "reason": {
          "$ref": "#/$defs/RejectReason"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "t",
        "command_id",
        "robot_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "CommandCompleted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_completed"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "energy_used_wh": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "t",
        "command_id",
        "robot_id",
        "energy_used_wh"
      ],
      "additionalProperties": false
    },
    "CommandFailed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_failed"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "reason": {
          "$ref": "#/$defs/FailReason"
        },
        "detail": {
          "type": "string"
        },
        "energy_used_wh": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "t",
        "command_id",
        "robot_id",
        "reason",
        "energy_used_wh"
      ],
      "additionalProperties": false
    },
    "ScanResult": {
      "description": "Noisy measurements from a scan command. A verification scan of the finished pad uses the same event.",
      "type": "object",
      "properties": {
        "type": {
          "const": "scan_result"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "site_map.schema.json#/$defs/CellObservation"
          }
        }
      },
      "required": [
        "type",
        "t",
        "command_id",
        "robot_id",
        "cells"
      ],
      "additionalProperties": false
    },
    "RobotFault": {
      "type": "object",
      "properties": {
        "type": {
          "const": "robot_fault"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "robot_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "cause": {
          "$ref": "#/$defs/FaultCause"
        },
        "component": {
          "$ref": "#/$defs/Component"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "field_repairable": {
          "description": "Whether a field repair can clear this fault. Always true for degraded faults.",
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "t",
        "robot_id",
        "cause",
        "component",
        "severity",
        "field_repairable"
      ],
      "additionalProperties": false
    },
    "Weather": {
      "type": "object",
      "properties": {
        "type": {
          "const": "weather"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "condition": {
          "$ref": "#/$defs/WeatherCondition"
        },
        "optical_depth": {
          "description": "Atmospheric dust opacity (tau). ~0.5 clear, >2 severe storm.",
          "type": "number",
          "minimum": 0
        },
        "temperature_c": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "t",
        "condition",
        "optical_depth",
        "temperature_c"
      ],
      "additionalProperties": false
    },
    "Power": {
      "description": "Site power grid snapshot. Reported on change and at least once per sol.",
      "type": "object",
      "properties": {
        "type": {
          "const": "power"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "solar_w": {
          "type": "number",
          "minimum": 0
        },
        "fission_w": {
          "type": "number",
          "minimum": 0
        },
        "demand_w": {
          "type": "number",
          "minimum": 0
        },
        "storage_wh": {
          "description": "Energy in the site battery bank.",
          "type": "number",
          "minimum": 0
        },
        "storage_capacity_wh": {
          "type": "number",
          "minimum": 0
        },
        "daylight": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "t",
        "solar_w",
        "fission_w",
        "demand_w",
        "storage_wh",
        "storage_capacity_wh",
        "daylight"
      ],
      "additionalProperties": false
    },
    "Comms": {
      "description": "State of the Earth link. While down, outbound messages queue at the site and inbound ones are not delivered.",
      "type": "object",
      "properties": {
        "type": {
          "const": "comms"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "cause": {
          "$ref": "#/$defs/CommsCause"
        },
        "one_way_delay_s": {
          "$ref": "common.schema.json#/$defs/Duration"
        },
        "expected_restore_t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        }
      },
      "required": [
        "type",
        "t",
        "link",
        "cause",
        "one_way_delay_s"
      ],
      "additionalProperties": false
    },
    "EarthMessage": {
      "description": "A message from mission control arriving at the site after the light-time delay.",
      "type": "object",
      "properties": {
        "type": {
          "const": "earth_message"
        },
        "t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "sent_t": {
          "$ref": "common.schema.json#/$defs/SimTime"
        },
        "message": {
          "$ref": "earth.schema.json#/$defs/EarthToSite"
        }
      },
      "required": [
        "type",
        "t",
        "sent_t",
        "message"
      ],
      "additionalProperties": false
    },
    "RejectReason": {
      "description": "Why a command was not accepted. unknown_robot: no robot has that id. busy: the robot is executing a command or is engaged by another robot. missing_capability: the robot lacks the capability the command needs. invalid_target: the cell, area, robot, station or depot is unknown, off the site, or not in a state the command can act on; also a reused command_id. out_of_coverage: the robot is outside comms coverage. robot_disabled: the robot is failed, stuck, offline, being towed or lost. approval_required: the action's authority level needs an Earth approval that has not been obtained. vetoed: Earth vetoed the cited approval request.",
      "enum": [
        "unknown_robot",
        "busy",
        "missing_capability",
        "invalid_target",
        "out_of_coverage",
        "robot_disabled",
        "approval_required",
        "vetoed"
      ]
    },
    "FailReason": {
      "description": "Why an accepted command stopped before finishing. fault: the robot suffered a disabled fault. stuck: the robot got stuck in soft regolith. insufficient_energy: the battery could not cover the next step, or ran out while holding or queueing. out_of_coverage: reserved; not produced under the v0.2.0 semantics. blocked: something the next step needs no longer holds, for example a cell that is not ready, nothing to load, or a busy charger or target. cancelled: stopped by a cancel command. target_lost: the robot the command was heading for moved away or was lost.",
      "enum": [
        "fault",
        "stuck",
        "insufficient_energy",
        "out_of_coverage",
        "blocked",
        "cancelled",
        "target_lost"
      ]
    },
    "FaultCause": {
      "description": "wear: accumulated wear on the component. random: a failure with no warning. environmental: caused by the environment, such as sensors knocked out by a dust storm.",
      "enum": [
        "wear",
        "random",
        "environmental"
      ]
    },
    "Severity": {
      "description": "degraded: the robot keeps working with a component-specific penalty. disabled: the robot stops, its command fails with `fault`, and it is `failed` until the fault is cleared.",
      "enum": [
        "degraded",
        "disabled"
      ]
    },
    "Component": {
      "description": "Robot component, in snake_case. ArcadiaBench v1 uses wheels, drive_motor, joints, tool, sensors and battery.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "WeatherCondition": {
      "enum": [
        "clear",
        "dust_storm"
      ]
    },
    "Link": {
      "description": "State of the Earth link.",
      "enum": [
        "up",
        "down"
      ]
    },
    "CommsCause": {
      "description": "nominal: the link is in its normal state. conjunction: solar conjunction blackout. outage: unplanned outage.",
      "enum": [
        "nominal",
        "conjunction",
        "outage"
      ]
    }
  }
}
