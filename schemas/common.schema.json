{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabe-Soler/arcadia-protocol/v0.1.0/schemas/common.schema.json",
  "title": "Common types",
  "description": "Shared primitives. Units are SI: metres, seconds, kilograms, watt-hours (Wh), watts (W). Sim time is seconds since mission start; one sol is 88775 s.",
  "$defs": {
    "Id": {
      "description": "Opaque identifier for robots, commands, messages, goals, stations.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "SimTime": {
      "description": "Seconds since mission start.",
      "type": "number",
      "minimum": 0
    },
    "Duration": {
      "description": "Seconds.",
      "type": "number",
      "minimum": 0
    },
    "GridCoord": {
      "description": "Integer cell coordinate. x grows east, y grows north, origin at the south-west corner.",
      "type": "object",
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "GridRect": {
      "description": "Axis-aligned rectangle of cells, inclusive of both corners.",
      "type": "object",
      "properties": {
        "min": { "$ref": "#/$defs/GridCoord" },
        "max": { "$ref": "#/$defs/GridCoord" }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "SoftwareInfo": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    }
  }
}
