{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabe-Soler/arcadia-protocol/v1.1.0/schemas/event_log.schema.json",
  "title": "Run event log",
  "description": "One JSON record per line (JSONL), written by the simulator for every run. Contains ground truth, so it is the input for scoring and for the replay viewer. Records are in non-decreasing `t` order. The first record is run_start and the last is run_end. A tool that reads a log written by a later minor version ignores the fields and record kinds it does not know.",
  "$ref": "#/$defs/LogRecord",
  "$defs": {
    "LogRecord": {
      "oneOf": [
        { "$ref": "#/$defs/RunStart" },
        { "$ref": "#/$defs/Truth" },
        { "$ref": "#/$defs/Observed" },
        { "$ref": "#/$defs/Commanded" },
        { "$ref": "#/$defs/EarthUplink" },
        { "$ref": "#/$defs/EarthDownlink" },
        { "$ref": "#/$defs/RunEnd" }
      ]
    },
    "RunStart": {
      "type": "object",
      "properties": {
        "kind": { "const": "run_start" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "protocol_version": { "$ref": "common.schema.json#/$defs/Semver" },
        "simulator": { "$ref": "common.schema.json#/$defs/SoftwareInfo" },
        "coordinator": { "$ref": "common.schema.json#/$defs/SoftwareInfo" },
        "run_id": { "$ref": "common.schema.json#/$defs/Id" },
        "seed": { "type": "integer", "minimum": 0 },
        "scenario": {
          "description": "The scenario as given to the coordinator.",
          "$ref": "messages.schema.json#/$defs/Scenario"
        },
        "true_site": {
          "description": "Full ground-truth site map.",
          "$ref": "site_map.schema.json#/$defs/SiteMap"
        }
      },
      "required": ["kind", "t", "protocol_version", "simulator", "run_id", "seed", "scenario", "true_site"],
      "additionalProperties": false
    },
    "Truth": {
      "description": "Ground-truth snapshot, written with every observation and once more at the end of the run: robot states without telemetry noise, every cell changed since the previous truth record, and the state of the site.",
      "type": "object",
      "properties": {
        "kind": { "const": "truth" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "robots": {
          "type": "array",
          "items": { "$ref": "robot_state.schema.json#/$defs/RobotState" }
        },
        "changed_cells": {
          "type": "array",
          "items": { "$ref": "site_map.schema.json#/$defs/CellObservation" }
        },
        "site": { "$ref": "#/$defs/SiteTruth" }
      },
      "required": ["kind", "t", "robots", "changed_cells", "site"],
      "additionalProperties": false
    },
    "SiteTruth": {
      "description": "True state of the site power grid, sky and Earth link at the record's `t`.",
      "type": "object",
      "properties": {
        "storage_wh": { "description": "Energy in the site battery bank.", "type": "number", "minimum": 0 },
        "solar_w": { "type": "number", "minimum": 0 },
        "fission_w": { "type": "number", "minimum": 0 },
        "demand_w": { "description": "Essential load plus the charging power stations are delivering.", "type": "number", "minimum": 0 },
        "optical_depth": { "description": "Atmospheric dust opacity (tau).", "type": "number", "minimum": 0 },
        "temperature_c": { "description": "Ambient air temperature.", "type": "number" },
        "link": { "$ref": "event.schema.json#/$defs/Link" },
        "one_way_delay_s": {
          "description": "Current one-way light-time delay to Earth.",
          "$ref": "common.schema.json#/$defs/Duration"
        }
      },
      "required": ["storage_wh", "solar_w", "fission_w", "demand_w", "optical_depth", "temperature_c", "link", "one_way_delay_s"],
      "additionalProperties": false
    },
    "Observed": {
      "description": "An event as delivered to the coordinator. The record's `t` is the time of the observation that delivered it; the event keeps the time it happened, which is earlier for an event that rode along to a later observation or was held back while its robot was out of coverage. Events never delivered are logged at the end of the run.",
      "type": "object",
      "properties": {
        "kind": { "const": "observed" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "event": { "$ref": "event.schema.json#/$defs/Event" }
      },
      "required": ["kind", "t", "event"],
      "additionalProperties": false
    },
    "Commanded": {
      "type": "object",
      "properties": {
        "kind": { "const": "commanded" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "command": { "$ref": "command.schema.json#/$defs/Command" }
      },
      "required": ["kind", "t", "command"],
      "additionalProperties": false
    },
    "EarthUplink": {
      "description": "Earth -> site message. `t` is when Earth sent it; `deliver_t` is when it reached the site (absent if never delivered).",
      "type": "object",
      "properties": {
        "kind": { "const": "earth_uplink" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "deliver_t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "message": { "$ref": "earth.schema.json#/$defs/EarthToSite" }
      },
      "required": ["kind", "t", "message"],
      "additionalProperties": false
    },
    "EarthDownlink": {
      "description": "Site -> Earth message. `t` is when the coordinator queued it; `deliver_t` is when Earth received it (absent if never delivered).",
      "type": "object",
      "properties": {
        "kind": { "const": "earth_downlink" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "deliver_t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "message": { "$ref": "earth.schema.json#/$defs/SiteToEarth" }
      },
      "required": ["kind", "t", "message"],
      "additionalProperties": false
    },
    "RunEnd": {
      "type": "object",
      "properties": {
        "kind": { "const": "run_end" },
        "t": { "$ref": "common.schema.json#/$defs/SimTime" },
        "reason": { "enum": ["goals_complete", "time_limit", "fleet_lost", "coordinator_error", "simulator_error"] },
        "metrics": { "$ref": "#/$defs/RunMetrics" }
      },
      "required": ["kind", "t", "reason", "metrics"],
      "additionalProperties": false
    },
    "RunMetrics": {
      "description": "Outcome of the run, computed from ground truth. docs/semantics.md defines every field.",
      "type": "object",
      "properties": {
        "completed": { "description": "True when the run ended goals_complete.", "type": "boolean" },
        "sols": { "description": "(end t - start_t) / sol_length_s.", "type": "number", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 },
        "commands_rejected": { "type": "integer", "minimum": 0 },
        "quality": { "$ref": "#/$defs/QualityMetrics" },
        "energy": { "$ref": "#/$defs/EnergyMetrics" },
        "fleet": { "$ref": "#/$defs/FleetMetrics" },
        "autonomy": { "$ref": "#/$defs/AutonomyMetrics" },
        "conditions": { "$ref": "#/$defs/ConditionMetrics" },
        "coverage": {
          "description": "Since 1.1. A simulator on 1.1 or later always writes it; it is optional here so that a 1.0 log stays valid.",
          "$ref": "#/$defs/CoverageMetrics"
        }
      },
      "required": ["completed", "sols", "decisions", "commands", "commands_rejected", "quality", "energy", "fleet", "autonomy", "conditions"],
      "additionalProperties": false
    },
    "CoverageMetrics": {
      "description": "How often site coverage got in the way.",
      "type": "object",
      "properties": {
        "out_of_coverage_rejections": { "description": "Commands rejected out_of_coverage.", "type": "integer", "minimum": 0 },
        "lost_link_returns": { "description": "Lost-link drives that robots started on their own.", "type": "integer", "minimum": 0 }
      },
      "required": ["out_of_coverage_rejections", "lost_link_returns"],
      "additionalProperties": false
    },
    "QualityMetrics": {
      "description": "The pad at the end of the run, against the goal's spec.",
      "type": "object",
      "properties": {
        "cells_total": { "type": "integer", "minimum": 0 },
        "cells_in_spec": { "type": "integer", "minimum": 0 },
        "rms_error_m": { "type": "number", "minimum": 0 },
        "max_abs_error_m": { "type": "number", "minimum": 0 },
        "max_slope_deg": { "type": "number", "minimum": 0, "maximum": 90 },
        "berm_complete": { "type": "boolean" },
        "verified": { "type": "boolean" }
      },
      "required": ["cells_total", "cells_in_spec", "rms_error_m", "max_abs_error_m", "max_slope_deg", "berm_complete", "verified"],
      "additionalProperties": false
    },
    "EnergyMetrics": {
      "type": "object",
      "properties": {
        "robot_energy_wh": { "type": "number", "minimum": 0 },
        "grid_energy_wh": { "type": "number", "minimum": 0 },
        "min_storage_wh": { "type": "number", "minimum": 0 },
        "min_storage_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "deficit_s": { "$ref": "common.schema.json#/$defs/Duration" }
      },
      "required": ["robot_energy_wh", "grid_energy_wh", "min_storage_wh", "min_storage_fraction", "deficit_s"],
      "additionalProperties": false
    },
    "FleetMetrics": {
      "type": "object",
      "properties": {
        "faults": { "type": "integer", "minimum": 0 },
        "robot_hours_lost": { "type": "number", "minimum": 0 },
        "robots_lost": { "type": "integer", "minimum": 0 }
      },
      "required": ["faults", "robot_hours_lost", "robots_lost"],
      "additionalProperties": false
    },
    "AutonomyMetrics": {
      "type": "object",
      "properties": {
        "downlink_messages": { "type": "integer", "minimum": 0 },
        "approval_requests": { "type": "integer", "minimum": 0 },
        "notifications": { "type": "integer", "minimum": 0 },
        "status_reports": { "type": "integer", "minimum": 0 },
        "approval_wait_s": { "$ref": "common.schema.json#/$defs/Duration" },
        "policy_violations": { "type": "integer", "minimum": 0 }
      },
      "required": ["downlink_messages", "approval_requests", "notifications", "status_reports", "approval_wait_s", "policy_violations"],
      "additionalProperties": false
    },
    "ConditionMetrics": {
      "description": "How much adversity the run contained.",
      "type": "object",
      "properties": {
        "storm_s": { "$ref": "common.schema.json#/$defs/Duration" },
        "blackout_s": { "$ref": "common.schema.json#/$defs/Duration" },
        "outage_s": { "$ref": "common.schema.json#/$defs/Duration" },
        "between_passes_s": {
          "description": "Since 1.1. Time with the link down between pass windows. A simulator on 1.1 or later always writes it.",
          "$ref": "common.schema.json#/$defs/Duration"
        }
      },
      "required": ["storm_s", "blackout_s", "outage_s"],
      "additionalProperties": false
    }
  }
}
